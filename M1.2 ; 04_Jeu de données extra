------------------------------------------------------------------------
-- 3. JOUER (association porteuse ARTISTE <-> CONCERT)
--    Concert n : 1 + MOD(n, 3) artistes du même genre que le concert.
--    Les artistes choisis sont distincts (rangs MOD(n + k, 6) + 1, k = 1..3),
--    ce qui respecte PK_JOUER et UQ_JOUER_ORDRE.
------------------------------------------------------------------------
INSERT INTO JOUER (id_personne, id_concert, ordre_de_passage, cachet)
SELECT a.id_personne,
       c.id_concert,
       k.n AS ordre_de_passage,
       CASE WHEN k.n = 1 + MOD(c.id_concert, 3)                    -- tête d'affiche
            THEN 3000 + MOD(c.id_concert * 37, 10) * 500
            ELSE 800  + MOD(c.id_concert * 13 + k.n * 7, 8) * 150   -- première partie
       END AS cachet
FROM CONCERT c
CROSS JOIN (SELECT LEVEL AS n FROM dual CONNECT BY LEVEL <= 3) k
JOIN (SELECT id_personne, genre_musical,
             ROW_NUMBER() OVER (PARTITION BY genre_musical ORDER BY id_personne) AS rang
      FROM ARTISTE) a
  ON  a.genre_musical = c.categorie
  AND a.rang = MOD(c.id_concert + k.n, 6) + 1
WHERE k.n <= 1 + MOD(c.id_concert, 3);

COMMIT;

------------------------------------------------------------------------
-- 4. VÉRIFICATION
------------------------------------------------------------------------
SELECT (SELECT COUNT(*) FROM ARTISTE) AS nb_artistes,
       (SELECT COUNT(*) FROM JOUER)   AS nb_passages,
       (SELECT COUNT(DISTINCT id_concert) FROM JOUER) AS concerts_programmes,
       (SELECT COUNT(*) FROM CONCERT) AS concerts_total
FROM dual;

-- Exemple : programme des 3 premiers concerts
SELECT j.id_concert, c.libelle, j.ordre_de_passage, a.nom_de_scene, j.cachet
FROM JOUER j
JOIN ARTISTE a ON a.id_personne = j.id_personne
JOIN CONCERT c ON c.id_concert  = j.id_concert
WHERE j.id_concert <= 3
ORDER BY j.id_concert, j.ordre_de_passage;
